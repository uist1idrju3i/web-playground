{
  "name": "web-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "generate": "node scripts/generate-feature-data.mjs && node scripts/generate-wasm-probes.mjs && node scripts/generate-capability-reference.mjs && node scripts/generate-prefecture-data.mjs",
    "check:generated": "npm run generate && node scripts/vendor-codemirror.mjs --check && git diff --exit-code HEAD -- public_html/library/data/web-features.json docs/web-platform-features.md docs/capability-reference.md public_html/library/wasm/probes public_html/tsumiki/data/prefectures.json",
    "lint": "eslint . && node scripts/check-external-resources.mjs && node scripts/check-doc-links.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:servo": "node --test tests/servo/run.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "npm run lint && npm run format:check && npm run check:generated && npm run test:unit && npm run test:e2e && npm run test:servo"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/streamparser": "6.0.0",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@lezer/common": "1.5.4",
    "@lezer/css": "1.3.9",
    "@lezer/highlight": "1.2.5",
    "@lezer/html": "1.3.13",
    "@lezer/javascript": "1.5.6",
    "@lezer/json": "1.0.3",
    "@lezer/lr": "1.4.11",
    "@lezer/markdown": "1.8.1",
    "@marijn/find-cluster-break": "1.0.4",
    "@mdn/browser-compat-data": "8.1.5",
    "@playwright/test": "1.64.0",
    "@replit/codemirror-vim": "6.4.0",
    "@replit/codemirror-vim-core": "0.1.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "binaryen": "132.0.0",
    "crelt": "1.0.7",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "parse5": "8.0.1",
    "prettier": "3.9.9",
    "style-mod": "4.1.4",
    "w3c-keyname": "2.2.8",
    "web-features": "3.42.0"
  }
}
