{
  "name": "web-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-feature-data.mjs && node scripts/generate-wasm-probes.mjs",
    "check:generated": "npm run generate && git diff --exit-code HEAD -- public_html/library/data/web-features.json docs/web-platform-features.md public_html/library/wasm/probes",
    "lint": "eslint . && node scripts/check-external-resources.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test tests/unit",
    "test:e2e": "playwright test",
    "serve": "node scripts/serve.mjs",
    "test": "npm run lint && npm run format:check && npm run check:generated && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@mdn/browser-compat-data": "8.1.5",
    "@playwright/test": "1.56.1",
    "binaryen": "132.0.0",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "web-features": "3.42.0"
  }
}
