{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Browser Features",
  "version": "0.1.0",
  "identifier": "jp.web-playground.browser-features",
  "build": {
    "frontendDist": "../../../public_html"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Browser Features",
        "width": 1280,
        "height": 900,
        "url": "browser-features/index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'report-sample' https://cdnjs.cloudflare.com; style-src 'self' 'report-sample' https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin",
        "X-Content-Type-Options": "nosniff"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
